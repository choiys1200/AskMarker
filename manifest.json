{
  "manifest_version": 3,
  "name": "Qubble",
  "version": "0.12.0",
  "description": "질문 때문에 읽던 흐름을 끊지 마세요. AI 답변에 질문을 남기고, 모아서 다시 물어보세요.",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Qubble 켜기 / 열기",
    "default_icon": {
      "16": "assets/icons/markchat-16.png",
      "24": "assets/icons/markchat-24.png",
      "32": "assets/icons/markchat-32.png",
      "48": "assets/icons/markchat-48.png",
      "128": "assets/icons/markchat-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/markchat-16.png",
    "32": "assets/icons/markchat-32.png",
    "48": "assets/icons/markchat-48.png",
    "128": "assets/icons/markchat-128.png"
  },
  "optional_host_permissions": [
    "https://www.googleapis.com/*",
    "https://api.notion.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
