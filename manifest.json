{
  "manifest_version": 3,
  "name": "AskMarker",
  "version": "0.10.1",
  "description": "선택한 내용에 코멘트를 남기고, 모아서 입력하고, 승인한 대화를 내보냅니다.",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AskMarker 켜기 / 열기",
    "default_icon": {
      "16": "assets/icons/markchat-16.png",
      "24": "assets/icons/markchat-24.png",
      "32": "assets/icons/markchat-32.png",
      "48": "assets/icons/markchat-48.png",
      "128": "assets/icons/markchat-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/markchat-16.png",
    "32": "assets/icons/markchat-32.png",
    "48": "assets/icons/markchat-48.png",
    "128": "assets/icons/markchat-128.png"
  },
  "optional_host_permissions": [
    "https://www.googleapis.com/*",
    "https://api.notion.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
